{
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(lib/**)",
      "Edit(src/**)",
      "Edit(test/**)",
      "Edit(example/**)",
      "Edit(build/ffmpeg/**)",
      "Edit(build/versions.env)",
      "Edit(tool/**)",
      "Edit(android/**)",
      "Edit(ios/**)",
      "Edit(macos/**)",
      "Edit(windows/**)",
      "Edit(licenses/**)",
      "Edit(docs/**)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(pubspec.yaml)",
      "Edit(analysis_options.yaml)",
      "Edit(ffigen.yaml)",
      "Edit(.gitignore)",
      "Edit(.pubignore)",
      "Edit(README.md)",
      "Edit(README_JA.md)",
      "Edit(CHANGELOG.md)",
      "Edit(CLAUDE.md)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch -a)",
      "Bash(ls:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter pub add:*)",
      "Bash(flutter --version)",
      "Bash(flutter doctor:*)",
      "Bash(dart analyze:*)",
      "Bash(dart format:*)",
      "Bash(dart test:*)",
      "Bash(dart run ffigen:*)",
      "Bash(dart pub publish --dry-run:*)",
      "Bash(dart pub deps:*)",
      "Bash(dart pub get:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git remote:*)",
      "Bash(git tag:*)",
      "Bash(git stash:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh release:*)",
      "Bash(gh api:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh label:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongosh:*)",
      "Bash(redis-cli:*)",
      "Bash(sqlite3:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-protected-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-save.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-dependencies.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh"
          },
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Completed\" with title \"su3_flutter_audio_converter\"'"
          }
        ]
      }
    ]
  }
}
