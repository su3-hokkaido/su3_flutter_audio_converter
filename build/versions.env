# Pinned versions of the bundled native libraries (docs/project_plan.md section 6.2).
# Checksums are SHA-256 of the source tarballs. Fill them with:
#   build/ffmpeg/fetch_sources.sh --print-checksums
# and compare FFmpeg's against the signature published next to the tarball before trusting them.
FFMPEG_VERSION=8.1.3
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-8.1.3.tar.xz
FFMPEG_SHA256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3

LAME_VERSION=3.100
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

# Lowest macOS version the dylibs may run on (Flutter's macOS minimum).
MACOS_DEPLOYMENT_TARGET=10.15

# Lowest iOS version the frameworks may run on (raised from Flutter's 13.0 because Xcode 27 supports 15.0 and later).
IOS_DEPLOYMENT_TARGET=15.0

# Android: NDK matches Flutter 3.35's default (flutter.ndkVersion); API level matches flutter.minSdkVersion.
ANDROID_NDK_VERSION=27.0.12077973
ANDROID_API_LEVEL=24

# GitHub Release that holds the prebuilt libraries for this commit (tool/fetch_prebuilt.sh, and the
# prebuilt workflow, which refuses a tag that differs from PREBUILT_TAG). Bump the number whenever
# the FFmpeg/LAME versions, configure options or deployment targets above change.
PREBUILT_REPO=su3-hokkaido/su3_flutter_audio_converter
PREBUILT_TAG=prebuilt-v1
